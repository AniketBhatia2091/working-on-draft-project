# DayKhata Release Signing Keystore Configuration Example
# Copy this file to keystore.properties and fill in your real keystore details:
# DO NOT commit keystore.properties or keystore files (*.jks, *.keystore) to version control.

storeFile=daykhata-release.jks
storePassword=your_keystore_password
keyAlias=daykhata
keyPassword=your_key_password
